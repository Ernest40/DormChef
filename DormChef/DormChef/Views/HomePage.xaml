<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DormChef.Views.HomePage"
             Title="Home"
             BackgroundColor="#FFF8F0">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20"
                                 Spacing="20"
                                 VerticalOptions="Center">

                <Label Text="Welcome to Dorm Chef"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Label Text="Find a recipe"
                       FontSize="18"
                       TextColor="Gray"
                       HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12"
                      Margin="0,30,0,0">

                    <Button Text="Breakfast"
                            Grid.Row="0"
                            Grid.Column="0"
                            Clicked="OnBreakfastClicked"
                            BackgroundColor="#FFCC80"
                            TextColor="Black"
                            CornerRadius="15"
                            HeightRequest="65"/>

                    <Button Text="Lunch"
                            Grid.Row="0"
                            Grid.Column="1"
                            Clicked="OnLunchClicked"
                            BackgroundColor="#A5D6A7"
                            TextColor="Black"
                            CornerRadius="15"
                            HeightRequest="65"/>

                    <Button Text="Dinner"
                            Grid.Row="1"
                            Grid.Column="0"
                            Clicked="OnDinnerClicked"
                            BackgroundColor="#90CAF9"
                            TextColor="Black"
                            CornerRadius="15"
                            HeightRequest="65"/>

                    <Button Text="Snacks"
                            Grid.Row="1"
                            Grid.Column="1"
                            Clicked="OnSnacksClicked"
                            BackgroundColor="#F48FB1"
                            TextColor="Black"
                            CornerRadius="15"
                            HeightRequest="65"/>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Fixed Bottom Nav -->
        <Grid Grid.Row="1"
              BackgroundColor="White"
              Padding="10"
              HeightRequest="70"
              ColumnDefinitions="*,*,*">

            <Button Text="Home"
                    Grid.Column="0"
                    Clicked="OnHomeNavClicked"
                    BackgroundColor="Transparent"
                    TextColor="#FF914D"/>

            <Button Text="Favorites"
                    Grid.Column="1"
                    Clicked="OnFavoritesNavClicked"
                    BackgroundColor="Transparent"
                    TextColor="Black"/>

            <Button Text="Profile"
                    Grid.Column="2"
                    Clicked="OnProfileNavClicked"
                    BackgroundColor="Transparent"
                    TextColor="Black"/>
        </Grid>

    </Grid>
</ContentPage>